{
  "name": "basalt",
  "version": "2.27.0",
  "versionNames": {
    "stable": "Hajrudin",
    "beta": "Caesar Clown"
  },
  "private": false,
  "main": "build/main/main.js",
  "homepage": "./",
  "license": "GPL-3.0-only",
  "description": "An Open Source Launcher for GOG, Epic Games and Amazon Games",
  "repository": {
    "type": "Github",
    "url": "https://github.com/Sudo-Ivan/basalt"
  },
  "author": {
    "name": "Sudo-Ivan",
    "email": "ivan@quad4.io"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "start": "electron-vite dev --watch",
    "codecheck": "tsc --noEmit",
    "find-deadcode": "ts-prune --error",
    "test": "jest",
    "test:flatpak": "node --test flatpak/prepareFlatpak.test.js",
    "test-watch": "jest --watch --maxWorkers=25%",
    "test:ci": "jest --runInBand --silent",
    "prebuild": "rm -rf build",
    "build": "electron-vite build",
    "test:e2e": "pnpm run build && cross-env CI=e2e xvfb-maybe -- playwright test",
    "release:linux": "pnpm run build && electron-builder -p always --linux deb AppImage rpm pacman tar.xz",
    "release:mac": "pnpm run build && electron-builder -p always --mac --x64 --arm64",
    "release:win": "pnpm run build && electron-builder -p always --win --x64 --arm64",
    "release:updateFlathub:ci": "tsc flathub/update-flathub.ts --skipLibCheck --target es2015 --moduleResolution node --module commonjs && node flathub/update-flathub.js",
    "dist:linux": "pnpm run build && electron-builder --linux",
    "dist:mac": "export CSC_IDENTITY_AUTO_DISCOVERY=false && pnpm run build && electron-builder --mac",
    "dist:win": "pnpm run build && electron-builder --win",
    "dist:flatpak": "pnpm dist:linux appimage && pnpm flatpak:prepare && pnpm flatpak:build",
    "lint": "eslint --cache .",
    "lint-fix": "eslint --fix --ext .tsx,ts ./src",
    "flatpak:build": "cd flatpak-build && flatpak-builder build io.quad4.basalt.yml --install --force-clean --user",
    "flatpak:prepare": "node ./flatpak/prepareFlatpak.js",
    "flatpak:prepare-release": "node ./flatpak/prepareFlatpak.js release",
    "i18n": "i18next-cli extract",
    "prepare": "husky install",
    "prettier": "prettier --check .",
    "prettier-fix": "prettier --write .",
    "download-helper-binaries": "esbuild --bundle --platform=node --target=node21 meta/downloadHelperBinaries.ts | node",
    "lint-translations": "esbuild --bundle --platform=node --target=node21 meta/lintTranslations.ts | node"
  },
  "dependencies": {
    "easydl": "^1.2.0",
    "electron-store": "^8.2.0",
    "filesize": "^10.1.6",
    "fs-extra": "^11.4.1",
    "fuse.js": "^6.6.2",
    "graceful-fs": "^4.2.11",
    "ini": "^3.0.1",
    "intro.js": "^7.2.0",
    "intro.js-react": "^1.0.0",
    "json5": "^2.2.3",
    "plist": "^3.1.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "sanitize-filename": "^1.6.4",
    "sanitize-html": "^2.18.1",
    "semver": "^7.8.5",
    "shlex": "^2.1.2",
    "short-uuid": "^4.2.2",
    "simple-keyboard": "^3.8.201"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^9.39.5",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@node-steam/vdf": "^2.2.0",
    "@playwright/test": "^1.64.1",
    "@shockpkg/icon-encoder": "^2.1.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/fs-extra": "^11.0.4",
    "@types/graceful-fs": "^4.1.9",
    "@types/ini": "^1.3.34",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/plist": "^3.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/semver": "^7.8.0",
    "@types/source-map-support": "^0.5.10",
    "@types/tmp": "^0.2.6",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@xhayper/discord-rpc": "^1.5.1",
    "axios": "^1.20.0",
    "classnames": "^2.5.1",
    "cross-env": "^7.0.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-updater": "^6.8.11",
    "electron-vite": "^3.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fast-xml-parser": "^5.11.2",
    "husky": "^8.0.3",
    "i18next": "^22.5.1",
    "i18next-cli": "1.80.4",
    "i18next-fs-backend": "^2.6.9",
    "i18next-http-backend": "^2.7.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "js-yaml": "^5.5.0",
    "node-gyp": "^10.3.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^12.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "sass": "^1.106.1",
    "source-map-support": "^0.5.21",
    "steam-shortcut-editor": "^3.1.3",
    "tmp": "^0.2.7",
    "ts-jest": "^29.4.15",
    "ts-prune": "^0.10.3",
    "type-fest": "^3.13.1",
    "typed-emitter": "^2.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "undici": "^7.30.1",
    "vite-plugin-svgr": "^4.5.0",
    "xvfb-maybe": "^0.2.1",
    "zod": "^3.25.76",
    "zustand": "^4.5.7"
  }
}
